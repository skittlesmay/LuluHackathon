# Database
DATABASE_URL="file:./prisma/dev.db"

# AmoCRM
AMOCRM_ACCESS_TOKEN="your-access-token"
AMOCRM_MODE="demo"
AMOCRM_SUBDOMAIN="your-subdomain"

# AmoCRM Custom field IDs
AMOCRM_FIELD_ADULT_TICKETS=""
AMOCRM_FIELD_CHILD_TICKETS=""
AMOCRM_FIELD_INFANT_TICKETS=""
AMOCRM_FIELD_EXCURSION_DATE=""
AMOCRM_FIELD_PAYMENT_LINK=""

# AmoCRM Pipeline and status IDs
AMOCRM_PIPELINE_ID=""
AMOCRM_STATUS_BOOKED=""
AMOCRM_STATUS_PAID=""

# PayKeeper
PAYKEEPER_MODE="demo"
PAYKEEPER_SERVER="demo.paykeeper.ru"
PAYKEEPER_SECRET="demo"
PAYKEEPER_USER="demo"
PAYKEEPER_PASSWORD="demo"

# Email & SMTP
EMAIL_MODE="demo"
EMAIL_PROVIDER="smtp"
EMAIL_FROM="noreply@example.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="user@example.com"
SMTP_PASSWORD="your-smtp-password"

# Admin credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-admin-password"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
